# --- Platforma vinisto (server-to-server, nikdy do prohlížeče) -------------
# Základ URL platformy: dev https://prodejce.vinisto.dev, prod https://prodejce.vinisto.cz
VINISTO_API_URL=https://prodejce.vinisto.dev
# Hlavička X-Api-Key pro integrace (hodnota ze správce hesel; ve starém SPA VITE_INTEGRATIONS_API_KEY)
VINISTO_API_KEY=

# --- Session --------------------------------------------------------------
# Podpis session cookie (openssl rand -hex 32). Bez něj se nejde přihlásit.
SESSION_SECRET=

# --- Externí odkazy (volitelné, mají výchozí hodnoty) ----------------------
# NEXT_PUBLIC_MARKETING_URL=https://ads.vinisto.cz/vinisto-mkt/
# NEXT_PUBLIC_MANUALS_URL=https://www.vinisto.cz/vinisto-prodejce

# --- Chat s podporou (SupportBox, volitelné) --------------------------------
# Bez těchto hodnot se widget nenačte a tlačítka „Chat s podporou“ vedou na /kontakt.
# SUPPORTBOX_CHAT_ID=
# SUPPORTBOX_CHAT_SECRET=
