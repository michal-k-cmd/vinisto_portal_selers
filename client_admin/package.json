  "lint-staged": {
    "*.ts": [
      "eslint --ext .ts --fix",
      "tsc --noEmit"
    ],
    "*.tsx": [
      "eslint --ext .tsx --fix",
      "tsc --noEmit"
    ],
    "*.js": [
      "eslint --ext .js --fix"
    ],
    "*.jsx": [
      "eslint --ext .jsx --fix"
    ]
  },
  "private": true,
  "scripts": {
    "build": "vite build --mode=production",
    "build:dev": "vite build --mode=development",
    "build:testing": "vite build --mode=testing",
    "lint": "tsc --noEmit && eslint --ext .js,.jsx,.ts,.tsx ./src",
    "lint:errors": "tsc --noEmit && eslint --ext .js,.jsx,.ts,.tsx --quiet ./src",
    "lint:fix": "eslint --ext .js,.jsx,.ts,.tsx ./src --fix",
    "lint:styles": "npx prettier --write \"**/*.*css\" \"!**/*min.*css\"",
    "pre-commit": "lint-staged",
    "preinstall": "npx only-allow pnpm",
    "start": "vite",
    "gt": "cd ../packages/vinisto-api-client && pnpm gt"
  }
