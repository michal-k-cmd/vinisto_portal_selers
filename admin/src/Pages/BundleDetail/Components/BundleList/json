                "solomnishvili": {
                  "name": [
                    {
                      "language": "CZECH",
                      "value": "Solomnishvili"
                    }
                  ],
                  "description": [
                    {
                      "language": "CZECH",
                      "value": "Vinařství Solomnishvili z gruzínské Kachetie přináší autentická vína vyráběná tradiční metodou kvevri. Hliněné nádoby, zakopané v zemi, dodávají vínům jedinečný charakter. Rodinná tradice a moderní technologie se zde snoubí v dokonalé harmonii. S každou lahví, kterou najdete u nás na vinisto.cz, se přenesete do srdce Gruzie a ochutnáte kousek její bohaté vinařské historie. Objevte plné, harmonické chutě a vůně, které vás okouzlí."
                    }
                  ],
                  "metaDescription": [
                    {
                      "language": "CZECH",
                      "value": "Autentická gruzínská vína z Kachetie, vyráběná tradiční metodou kvevri. Objednejte na vinisto.cz a ochutnejte Gruzii"
                    }
                  ],
                  "imageId": [
