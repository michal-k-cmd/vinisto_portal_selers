  "devDependencies": {
    "@tanstack/react-query-devtools": "^4.36.1",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@types/react-gtm-module": "^2.0.4",
    "@types/react-highlight-words": "^0.20.0",
    "@types/react-slider": "^1.3.6",
    "@types/react-toastify": "^4.1.0",
    "@types/uuid": "^9.0.1",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^4.6.0",
    "lint-staged": "^15.4.3",
    "prettier": "^2.8.3",
    "stylelint": "^14.9.1",
    "stylelint-config-standard": "^26.0.0",
    "stylelint-prettier": "^2.0.0",
    "swagger-typescript-api": "^12.0.4",
    "typescript": "^5.8.2"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --ext .ts --fix",
      "tsc --noEmit"
    ],
    "*.tsx": [
      "eslint --ext .tsx --fix",
      "tsc --noEmit"
    ],
    "*.js": [
      "eslint --ext .js --fix"
    ],
    "*.jsx": [
      "eslint --ext .jsx --fix"
    ]
  },
  "private": true,
  "scripts": {
    "dev": "cross-env APP_ENV=development dotenv -e .env.development -c -- next dev",
    "dev:ssl": "cross-env APP_ENV=development dotenv -e .env.development -c -- next dev --experimental-https",
    "scan": "cross-env APP_ENV=development dotenv -e .env.development -c -- next dev && pnpx react-scan@latest localhost:3000",
    "build:ci": "cross-env APP_ENV=ci dotenv -e .env.ci -c -- next build",
    "build:dev": "cross-env APP_ENV=development dotenv -e .env.development -c -- next build",
    "build:testing": "cross-env APP_ENV=testing dotenv -e .env.testing -c -- next build",
    "build:staging": "cross-env APP_ENV=staging dotenv -e .env.staging -c -- next build",
    "build": "cross-env APP_ENV=production next build",
    "build:analyze": "cross-env APP_ENV=production ANALYZE=true next build",
    "start": "next start",
    "pre-commit": "lint-staged",
    "preinstall": "npx only-allow pnpm",
    "lint": "tsc --noEmit && eslint --ext .js,.jsx,.ts,.tsx ./src",
    "lint:errors": "tsc --noEmit && eslint --ext .js,.jsx,.ts,.tsx --quiet ./src",
    "lint:fix": "eslint --ext .js,.jsx,.ts,.tsx ./src --fix",
    "lint:styles": "npx prettier --write \"**/*.*css\" \"!**/*min.*css\"",
    "gt": "cd ../packages/vinisto-api-client && pnpm gt"
  }
}
